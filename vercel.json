{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/image-proxy", "destination": "/api/media?action=image" },
    { "source": "/api/tts", "destination": "/api/media?action=tts" },
    { "source": "/api/auth/session", "destination": "/api/auth-drive?route=session" },
    { "source": "/api/auth/google", "destination": "/api/auth-drive?route=google" },
    { "source": "/api/auth/callback", "destination": "/api/auth-drive?route=callback" },
    { "source": "/api/auth/logout", "destination": "/api/auth-drive?route=logout" },
    { "source": "/api/drive/sync", "destination": "/api/auth-drive?route=drive-sync" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|audio/|images/|icons/|manifest\\.webmanifest|sw\\.js|favicon\\.svg|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ]
}
